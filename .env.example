ZF_PHONE=
ZF_PASSWORD='your-password'
REPORT_BASIC_AUTH_USER=
REPORT_BASIC_AUTH_PASSWORD=

# Optional runtime settings
# HEADLESS=1
# USE_CHROME=0
# PROXY_URL=http://host:port
# VIEWPORT_WIDTH=1600
# VIEWPORT_HEIGHT=1200
# MAX_POSTS=20
# MAX_SCROLLS=120
# ZF_DAYS=3
# ZF_ENGAGED_DB=engaged-lotteries.sqlite
# ZF_ENGAGED_HTML=engaged-lotteries.html
# REPORT_HOST=127.0.0.1
# REPORT_PORT=8787
# CRAWL_INTERVAL_SECONDS=3600
# MESSAGE_FETCH_INTERVAL_SECONDS=900
# MESSAGE_FETCH_TIMEOUT_SECONDS=840
# HOURLY_RETRY_SECONDS=60
# CRAWLER_RUN_TIMEOUT_SECONDS=1800
# CRAWLER_RESTART_DELAY_SECONDS=60
# CRAWLER_KILL_AFTER_SECONDS=60
# RUN_ON_START=1

# Lottery participation: one independently random time per account/post in each
# clock hour from 07:30 to 24:00 (first slot: 07:30–08:00), until the draw.
# Plans persist in SQLite; missed hours are skipped, never replayed.
# Full feed discovery follows CRAWL_INTERVAL_SECONDS; due lotteries wake it sooner.
# ZF_SIGN_IN_TZ=Asia/Shanghai
