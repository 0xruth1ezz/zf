ZF_PHONE=
ZF_PASSWORD='your-password'
REPORT_BASIC_AUTH_USER=
REPORT_BASIC_AUTH_PASSWORD=

# Optional runtime settings
# HEADLESS=1
# USE_CHROME=0
# PROXY_URL=http://host:port
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080
# MAX_POSTS=20
# MAX_SCROLLS=120
# ZF_DAYS=3
# ZF_ENGAGED_DB=engaged-lotteries.sqlite
# ZF_ENGAGED_HTML=engaged-lotteries.html
# REPORT_HOST=127.0.0.1
# REPORT_PORT=8787
# CRAWL_INTERVAL_SECONDS=3600
# MESSAGE_FETCH_INTERVAL_SECONDS=900
# CRAWLER_RESTART_DELAY_SECONDS=60
# RUN_ON_START=1

# Lottery participation: one independently random time per account/post in each
# clock hour from 07:30 to 24:00 (first slot: 07:30–08:00), until the draw.
# Each post has a distinct persisted time; there is no fixed minimum interval.
# Each post sends an independent HTTP request at its scheduled second.
# Late/rejected jobs are randomized again; uncertain submissions wait until the next hour.
# Discovery and inbox checks share per-account sessions without blocking lottery timers.
# Sessions are validated daily over HTTP; Playwright runs only for missing/expired login.
# Saved cookies are stored with owner-only permissions under ZF_PROFILE_DIR/http-sessions.
# ZF_SIGN_IN_TZ=Asia/Shanghai
