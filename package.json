{
  "name": "zf",
  "version": "1.0.0",
  "description": "Crawlee + Playwright automation for zFrontier lottery posts.",
  "main": "zfrontier-lottery-crawler.js",
  "scripts": {
    "start": "node zfrontier-lottery-crawler.js",
    "dry-run": "node zfrontier-lottery-crawler.js --dry-run",
    "view": "node view-engaged-lotteries.js",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "build:css": "npm run build:ui",
    "watch:css": "npm run watch:ui",
    "serve:report": "npm run build:ui && cargo run --bin zfrontier-report-server",
    "test:node": "node --test",
    "check": "npm run build:ui && npm run check:node && npm run test:node && cargo test",
    "check:node": "node --check zfrontier-lottery-crawler.js && node --check engaged-store.js && node --check view-engaged-lotteries.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "crawlee": "^3.16.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.1",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "vite": "^7.1.4"
  }
}
